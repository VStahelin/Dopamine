{
  "name": "dopamina-blaster",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run sprites:check && npm run format:check && npm test && npm run build",
    "release": "node tools/release/release.mjs",
    "serve": "node tools/serve/serve.mjs",
    "sprites:build": "node tools/sprites/build.mjs",
    "sprites:check": "node tools/sprites/build.mjs --check",
    "sim": "node tools/sim/sim.mjs"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "selfsigned": "5.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.1.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.11",
    "workbox-window": "7.4.1"
  }
}
